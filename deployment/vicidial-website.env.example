# Templates only. Preserve existing production values; do not rotate encryption keys.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=keep-existing-production-value
CREDENTIAL_ENCRYPTION_KEY=keep-existing-production-value
# Only required when the existing secure PC AI gateway is used.
SHAHVEX_PC_AI_URL=https://existing-ai-gateway.example
SHAHVEX_PC_AI_SECRET=keep-existing-gateway-secret
SHAHVEX_CF_CLIENT_ID=keep-existing-cloudflare-access-client-id
SHAHVEX_CF_CLIENT_SECRET=keep-existing-cloudflare-access-client-secret
# Explicit dialer/bridge private hostnames only, comma separated. Never use wildcards.
SHAHVEX_VOIP_ALLOWED_HOSTS=dialer.internal.example,bridge.internal.example
SHAHVEX_TEST_OLLAMA_MODEL=qwen3:4b-instruct
# Server-managed defaults for new VoIP connections. Match the bridge host configuration.
SHAHVEX_VICIDIAL_BRIDGE_URL=https://bridge.internal.example
SHAHVEX_VICIDIAL_BRIDGE_SECRET=replace-with-a-random-secret-at-least-32-characters
# Dialer API credentials are saved encrypted via the VoIP UI.
# Bridge host environment: deployment/vicidial-bridge/bridge.env.example
