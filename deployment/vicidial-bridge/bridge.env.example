SHAHVEX_SITE_URL=https://your-website.example/
SHAHVEX_VICIDIAL_CONNECTION_ID=copy-the-connection-id-from-VoIP
SHAHVEX_VICIDIAL_BRIDGE_SECRET=replace-with-the-same-random-secret-saved-in-VoIP
SHAHVEX_VICIDIAL_CONTROL_PORT=8790
SHAHVEX_VICIDIAL_AUDIO_HOST=127.0.0.1
SHAHVEX_VICIDIAL_AUDIO_PORT=9019
SHAHVEX_VICIDIAL_MAX_CALLS=10
SHAHVEX_VICIDIAL_SPOOL=/var/lib/shahvex-vicidial/events
# Optional JSON overrides for the 8 kHz input gate, STT and interruption policy.
# Native campaign/manual JSON configs use the same object under "speech".
# SHAHVEX_VICIDIAL_SPEECH='{"gateDbfs":-25,"onsetMs":120,"endOfSpeechMs":350,"interruptionMs":800,"interruptionWords":2,"priorityProbeMs":320,"priorityProbeIntervalMs":320,"minConfidence":0.55,"shortSpeechMs":450,"shortSpeechDbfs":-22,"debug":false}'
