# Local: http://localhost:3000. Production: your public HTTPS domain.
# Current gateway verification is local only; no real calls.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional fixed USD/PKR display rate. Leave blank to use the daily online rate.
EXCHANGE_RATE_USD_PKR=

# REQUIRED for login, dashboards and saved data: PostgreSQL connection strings.
# DATABASE_URL may be pooled; DIRECT_URL must be a direct connection for Prisma.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
DIRECT_URL=

# REQUIRED: independent random secrets. The local .env has generated values.
# Keep these stable: changing them invalidates sessions / existing encrypted data.
AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Email verification, account notifications and contact form.
# Gmail SMTP uses smtp.gmail.com, port 465, SSL.
# PRIVATE_EMAIL_PASSWORD must be a Google App Password (requires 2-Step Verification).
PRIVATE_EMAIL_USER=shahvex1@gmail.com
PRIVATE_EMAIL_PASSWORD=
CONTACT_EMAIL=support@shahvex.com

# Avatars, scripts, documents and call recording uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Optional public credit-support links. NEXT_PUBLIC_* values are public.
NEXT_PUBLIC_BPO_WHATSAPP=https://wa.me/
NEXT_PUBLIC_BPO_INSTAGRAM=https://instagram.com/
NEXT_PUBLIC_BPO_MESSENGER=https://m.me/
# Separate Shahvex gateway: generate a random 32+ character secret.
# Loopback only; model endpoints must stay on the private engine network.
SHAHVEX_GATEWAY_TOKEN=
SHAHVEX_GATEWAY_PORT=8787
# Website backend only: current same-Windows-machine connection, no tunnel.
# Never prefix the URL or gateway token with NEXT_PUBLIC_.
SHAHVEX_GATEWAY_URL=http://127.0.0.1:8787
SHAHVEX_MAX_SESSIONS=1
# Optional JSON file matching a confirmed local engine bridge contract.
# Never commit a populated contract containing authentication tokens.
SHAHVEX_ENGINE_CONTRACT=
# Physical PC only: separate secret for the loopback Whisper wrapper.
SHAHVEX_WHISPER_TOKEN=
# Optional existing cached faster-whisper model path; no downloads are performed.
SHAHVEX_WHISPER_MODEL_PATH=base.en
# Reference engine inventory, not a claim of verified health or API compatibility:
# Optional Gateway intelligence pilot: server-side only, default OFF.
# Production/Vercel/Railway remain disabled even if this pilot flag is set.
SHAHVEX_AGENT_INTELLIGENCE=0
# Local reviewed policy registry; never use a NEXT_PUBLIC_ variable or client policy.
SHAHVEX_AGENT_INTELLIGENCE_POLICIES=
# Ollama shahvex-natural: private port 11434
# Chatterbox Turbo: private port 8765; Faster Whisper base.en CPU INT8

# Optional approved private VICIdial hosts (comma-separated exact hostnames/IPs).
# HTTPS/public destinations work by default; HTTP or private IPs require this server-side allowlist.
SHAHVEX_VOIP_ALLOWED_HOSTS=
